# MongoDB Atlas Connection String
# Replace the placeholder below with your MongoDB Atlas cluster URI.
# Format: mongodb+srv://<username>:<password>@<cluster-address>/arrivalride?retryWrites=true&w=majority
MONGODB_URI=

# Database Name (optional, defaults to 'arrivalride')
MONGODB_DB=arrivalride

# Server Port and Host
PORT=3000
HOST=0.0.0.0

